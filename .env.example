# Copy this file to .env and fill in real values. .env is gitignored — never commit real secrets.
#
# Local dev: source it before running Maven/Tomcat, e.g.
#   set -a; source .env; set +a; mvn clean install -Plocal
#
# Deployed servers (dev/prod EC2): create /etc/tracking/.env on the instance itself
# (outside the git-deployed artifact) with the real values, chmod 600, owned by root.
# install_dependencies / the tomcat7 init script source it automatically.

# --- Database (used at `mvn` build time to fill persistence.xml via pom.xml profiles) ---
DB_URL=jdbc:mysql://localhost:3306/trackingdev?useSSL=false&autoReconnect=true&failOverReadOnly=false&maxReconnects=10&useUnicode=true&characterEncoding=utf-8
DB_USER=
DB_PASSWORD=

# --- Mail (SMTP) ---
MAIL_USER=
MAIL_PASSWORD=

# --- External tracking/crawler server ---
TRACKING_SERVER_LOGIN=
TRACKING_SERVER_PASSWORD=

# --- Flex 1C client ---
TRACKING_CLIENT_FLEX_1C_USERNAME=
TRACKING_CLIENT_FLEX_1C_PASSWORD=

# --- Integration test fixtures (only needed for `mvn -Pinttests`) ---
HIBERNATE_CONNECTION_HOST=
HIBERNATE_CONNECTION_USERNAME=
HIBERNATE_CONNECTION_PASSWORD=
AUTH_USER_ID=
AUTH_USER_PASSWORD=
